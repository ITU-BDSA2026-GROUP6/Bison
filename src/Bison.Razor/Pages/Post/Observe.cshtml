@page "/Observe"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Bison.Razor.Pages.Post.ObserveModel
@{
    Layout = "Shared/_Layout";
}
<div class="observationbox">
    <h1>What have you observed?, @(User.Identity.Name)?</h1>

    <form method="post">
        <label asp-for="Message">Message:</label>

        <input asp-for="Message" type="text" required maxlength="128" />

        <br />
        <label asp-for="SelectedTaxonId">Taxon:</label>
        <select asp-for="SelectedTaxonId" asp-items="Model.Taxons">
            <option value="">-- Select a taxon (optional) --</option>
        </select>

        <button type="submit">Share</button>
    </form>

    @*
        -- To do: Add images to observations. --
    *@

</div>
