@page "/ob/{id:int?}"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Bison.Razor.Pages.ObservationDetailsModel
@{
    Layout = "Shared/_Layout";
}

@if (Model.Observation is null)
{
    <h2>Observations</h2>

    @foreach (var observation in Model.Observations)
    {
        <p>
            <a href="/ob/@observation.ObservationId">
                @observation.Message
            </a>
            by @observation.Author
        </p>
    }
}
else
{
    <h2>Observation</h2>
    <p><strong>@Model.Observation.Author</strong></p>
    <p>@Model.Observation.Message</p>
    <small>@Model.Observation.Timestamp</small>

    if (!string.IsNullOrEmpty(Model.Observation.VernacularName))
    {
        <h2>Taxon</h2>
        <p>@Model.Observation.VernacularName</p>
    }

    <h2>Proposals</h2>
    @foreach (var proposal in Model.Proposals)
    {
        <p>@proposal.Author proposed <strong>@proposal.TaxonName</strong>: @proposal.Message</p>
    }

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="observationbox">
            <h3>Propose a taxon?</h3>
            <form method="post" asp-page-handler="Proposal">
                <input style="float: left" type="text" asp-for="ProposalText">
                <select asp-for="SelectedTaxonId" asp-items="Model.Taxons">
                    <option value="">-- Select a taxon --</option>
                </select>
                <input type="submit" value="Propose">
            </form>
        </div>
    }

    <h2>Comments</h2>
    @foreach (var comment in Model.Comments)
    {
        <p><strong>@comment.Author:</strong> @comment.Message</p>
    }

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="observationbox">
            <h3>Add a comment?</h3>
            <form method="post" asp-page-handler="Comment">
                <input style="float: left" type="text" asp-for="CommentText">
                <input type="submit" value="Share">
            </form>
        </div>
    }
}