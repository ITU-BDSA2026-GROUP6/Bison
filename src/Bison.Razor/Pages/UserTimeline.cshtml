@page "/obs/{author}"
@model Bison.Razor.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("author");
}

<div>
    <h2> @routeName's Observations </h2>

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@ob.Author">@ob.Author</a>
                        </strong>
                        <a href="/ob/@ob.ObservationId">@ob.Message</a>
                        <small>&mdash; @ob.Timestamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no Observations so far.</em>
    }

    @{
        var currentPage = int.TryParse(HttpContext.Request.Query["page"], out var page)
        ? Math.Max(page, 1)
        : 1;
    }

    <<nav aria-label="Pagination">
        @if (currentPage > 1)
        {
            <a href="/obs/@routeName?page=@(currentPage - 1)">Previous</a>
        }

        @if (Model.Observations.Count == 32)
        {
            <a href="/obs/@routeName?page=@(currentPage + 1)">Next</a>
        }
    </nav>
</div>
