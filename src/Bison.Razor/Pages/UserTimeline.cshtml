@page "/obs/{author}"
@model Bison.Razor.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("author");
}

<div>
    <h2> @routeName's Observations </h2>

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <li>
                    <div class="observation-author">
                        <strong>
                            <a href="/obs/@ob.Author">@ob.Author</a>
                        </strong>
                    </div>
                    <div class="observation-message">
                        <a href="/ob/@ob.ObservationId">@ob.Message</a>
                    </div>
                    <small class="observation-timestamp">@ob.Timestamp</small>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no Observations so far.</em>
    }

    @{
        var pages = new SortedSet<int> { 1, Model.TotalPages };
        for (var pageNumber = Math.Max(1, Model.CurrentPage - 1);
             pageNumber <= Math.Min(Model.TotalPages, Model.CurrentPage + 1);
             pageNumber++)
        {
            pages.Add(pageNumber);
        }

        var previousPageNumber = 0;
    }

    <nav class="pagination" aria-label="Pagination">
        @if (Model.CurrentPage > 1)
        {
            <a class="pagination-item pagination-arrow" href="/obs/@routeName?page=@(Model.CurrentPage - 1)" aria-label="Previous page">&lsaquo;</a>
        }
        else
        {
            <span class="pagination-item pagination-arrow disabled" aria-hidden="true">&lsaquo;</span>
        }

        @foreach (var pageNumber in pages)
        {
            if (previousPageNumber > 0 && pageNumber - previousPageNumber > 1)
            {
                <span class="pagination-ellipsis" aria-hidden="true">&hellip;</span>
            }

            if (pageNumber == Model.CurrentPage)
            {
                <span class="pagination-item active" aria-current="page">@pageNumber</span>
            }
            else
            {
                <a class="pagination-item" href="/obs/@routeName?page=@pageNumber">@pageNumber</a>
            }

            previousPageNumber = pageNumber;
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a class="pagination-item pagination-arrow" href="/obs/@routeName?page=@(Model.CurrentPage + 1)" aria-label="Next page">&rsaquo;</a>
        }
        else
        {
            <span class="pagination-item pagination-arrow disabled" aria-hidden="true">&rsaquo;</span>
        }
    </nav>
</div>
