@page "/obs"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2> Public Timeline </h2>

    <form method="get" action="/obs">
        <select asp-for="SelectedTaxonId" asp-items="Model.Taxons">
            <option value="">-- All --</option>
        </select>
        <button type="submit">Filter</button>
    </form>

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <div class="observation-author">
                        <strong>
                            <a href="/obs/@obs.Author">@obs.Author</a>
                        </strong>
                    </div>
                    <div class="observation-message">
                        <a href="/ob/@obs.ObservationId">@obs.Message</a>
                    </div>
                    <small class="observation-timestamp">@obs.Timestamp</small>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }

    @{
        var pages = new SortedSet<int> { 1, Model.TotalPages };
        for (var pageNumber = Math.Max(1, Model.CurrentPage - 1);
             pageNumber <= Math.Min(Model.TotalPages, Model.CurrentPage + 1);
             pageNumber++)
        {
            pages.Add(pageNumber);
        }

        var previousPageNumber = 0;
    }

    <nav class="pagination" aria-label="Pagination">
        @if (Model.CurrentPage > 1)
        {
            <a class="pagination-item pagination-arrow"
                asp-page="/Public"
                asp-route-page="@(Model.CurrentPage - 1)"
                asp-route-SelectedTaxonId="@Model.SelectedTaxonId"
                aria-label="Previous page">&lsaquo;</a>        
                }
        else
        {
            <span class="pagination-item pagination-arrow disabled" aria-hidden="true">&lsaquo;</span>
        }

        @foreach (var pageNumber in pages)
        {
            if (previousPageNumber > 0 && pageNumber - previousPageNumber > 1)
            {
                <span class="pagination-ellipsis" aria-hidden="true">&hellip;</span>
            }

            if (pageNumber == Model.CurrentPage)
            {
                <span class="pagination-item active" aria-current="page">@pageNumber</span>
            }
            else
            {
                <a class="pagination-item"
                asp-page="/Public"
                asp-route-page="@pageNumber"
                asp-route-SelectedTaxonId="@Model.SelectedTaxonId">@pageNumber</a>
            }

            previousPageNumber = pageNumber;
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a class="pagination-item pagination-arrow"
            asp-page="/Public"
            asp-route-page="@(Model.CurrentPage + 1)"
            asp-route-SelectedTaxonId="@Model.SelectedTaxonId"
            aria-label="Next page">&rsaquo;</a>
        }
        else
        {
            <span class="pagination-item pagination-arrow disabled" aria-hidden="true">&rsaquo;</span>
        }
    </nav>
</div>
