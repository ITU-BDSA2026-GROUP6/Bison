@page "/obs"
@using Microsoft.EntityFrameworkCore
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2> Public Timeline </h2>

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@obs.Author">@obs.Author</a>
                        </strong>
                        @obs.Message
                        <small>&mdash; @obs.Timestamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }

    @{
        var currentPage = int.TryParse(HttpContext.Request.Query["page"], out var page)
        ? Math.Max(page, 1)
        : 1;
}

<nav aria-label="Pagination">
    @if (currentPage > 1)
    {
        <a href="/obs?page=@(currentPage - 1)">Previous</a>
    }

    @if (Model.Observations.Count == 32)
    {
        <a href="/obs?page=@(currentPage + 1)">Next</a>
    }
</nav>
</div>
